#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#define DEFAULT 0
#define JIS_BASE 1
#define FUNCTION 2
#define NUM 3
#define JIS_NUM 4
#define ARROW 5
#define MOUSE 6
#define SCROLL 7
#define MMO 8
#define MMO_ITEMS 9
#define BT 10

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_temp_layer {
    excluded-positions = <33 34 35>;
};

&pointing_listener {
    /*
     * Initial tuning baseline:
     * - PAW3222 CPI: driver default
     * - cursor scale: 1:1
     * - auto mouse: MOUSE layer for 700 ms
     * - SCROLL layer: map XY to wheel events, without auto mouse
     */
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 1 1>,
        <&zip_temp_layer MOUSE 700>;

    /* MMO中はマウスレイヤーの自動切替を行わない。 */
    mmo_mode {
        layers = <MMO MMO_ITEMS>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_scaler 1 1>;
    };

    scroll_mode {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 1>;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        jis_numbers {
            if-layers = <JIS_BASE NUM>;
            then-layer = <JIS_NUM>;
        };
    };
    combos {
        compatible = "zmk,combos";

        tab {
            layers = <DEFAULT JIS_BASE FUNCTION NUM JIS_NUM ARROW MOUSE SCROLL BT>;
            bindings = <&kp TAB>;
            key-positions = <26 27>;
        };

        shift_tab {
            layers = <DEFAULT JIS_BASE FUNCTION NUM JIS_NUM ARROW MOUSE SCROLL BT>;
            bindings = <&kp LS(TAB)>;
            key-positions = <27 28>;
        };
    };

    macros {
        select_host: select_host {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap
                        &macro_param_1to2 &bt BT_SEL 0
                        &macro_param_2to1 &to DEFAULT>;
        };

        clear_all_us: clear_all_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_CLR_ALL &to DEFAULT>;
        };

        to_jis_base: to_jis_base {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to JIS_BASE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to DEFAULT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        jis_minus: jis_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT_RO)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_quote: jis_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_7)>, <&kp LS(NUMBER_2)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_semi: jis_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp APOS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_equal: jis_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMICOLON)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_caret: jis_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp EQUAL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_at: jis_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACKET>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        jis_backslash: jis_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT_RO>, <&kp LS(INT_YEN)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        lt_to_jis: lt_to_jis {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&to_jis_base>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &lt SCROLL I  &kp O  &kp P  &none
                &none  &kp A  &kp S  &kp D  &kp F  &kp G  &none  &none  &kp H  &kp J  &kp K  &kp L  &kp MINUS  &none
                &none  &mt LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp DELETE  &kp ESCAPE  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &none
                &none  &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 BT CAPSLOCK  &lt NUM SPACE  &lt_to_layer_0 ARROW INT_MUHENKAN  &lt FUNCTION ENTER  &kp BACKSPACE  &none  &none  &kp APOS  &kp SEMICOLON  &none
            >;
        };

        jis_base_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &jis_minus  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &lt_to_jis BT CAPSLOCK  &trans  &lt_to_jis ARROW INT_MUHENKAN  &trans  &trans  &trans  &trans  &jis_quote  &jis_semi  &trans
            >;
        };

        function_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp F12  &kp F13  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS  &kp CARET  &kp HASH  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PERCENT  &trans
                &trans  &kp SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &trans  &trans  &kp EXCLAMATION  &kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOLLAR  &trans
                &trans  &mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL  &kp UNDERSCORE  &kp AMPERSAND  &kp AT_SIGN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PIPE  &trans
            >;
        };

        jis_num_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &jis_minus  &trans  &trans  &trans  &kp LS(SEMICOLON)  &jis_caret  &trans  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &kp LS(APOS)  &trans  &trans  &trans  &kp LS(EQUAL)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &jis_equal  &kp LS(INT_RO)  &kp LS(NUMBER_6)  &jis_at  &kp RIGHT_BRACKET  &kp BACKSLASH  &jis_backslash  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(INT_YEN)  &trans
            >;
        };

        arrow_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &kp LS(LC(TAB))  &kp UP_ARROW  &kp LC(TAB)  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans  &trans  &kp TAB  &kp LA(LEFT)  &kp LA(RIGHT)  &trans  &trans  &trans
                &trans  &kp LEFT_SHIFT  &kp LS(LG(LEFT_ARROW))  &trans  &kp LS(LG(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_WIN  &kp LEFT_ALT  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        scroll_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mmo_layer {
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &kp ESCAPE  &none  &none  &kp I  &kp M  &none  &none  &none  &none  &none  &none
                &none  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp C  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp Q  &kp V  &none  &none  &none  &none  &none  &none  &none
                &none  &kp E  &kp TAB  &kp SPACE  &kp LEFT_SHIFT  &mo MMO_ITEMS  &kp LEFT_ALT  &to DEFAULT  &none  &none  &none  &none  &none  &none
            >;
        };

        mmo_items_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp F5  &kp F6  &kp F7  &kp F8  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bt_layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &to MMO  &to DEFAULT  &trans  &trans  &trans  &select_host 0 DEFAULT  &select_host 1 DEFAULT  &select_host 2 JIS_BASE  &select_host 3 DEFAULT  &select_host 4 DEFAULT  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &clear_all_us  &trans
            >;
        };
    };
};
